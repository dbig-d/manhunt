    "test": "vitest run",
    "build:pages": "tsc -b && vite build --mode pages"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "maplibre-gl": "^6.15.0",
    "nosleep.js": "^0.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
